{
    "name": "@ssplib/react-components",
    "version": "0.1.0",
    "description": "SSP React Components",
    "author": "Pedro Henrique <sr.hudrick@gmail.com>",
    "license": "MIT",
    "private": false,
    "type": "module",
    "main": "dist/index.cjs.js",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.esm.js",
            "require": "./dist/index.cjs.js"
        }
    },
    "files": [
        "dist/**/*"
    ],
    "peerDependencies": {
        "@emotion/react": "^11.9.0",
        "@emotion/styled": "^11.8.1",
        "@mui/icons-material": "^5.0.0",
        "@mui/material": "^5.8.6",
        "@mui/x-date-pickers": "^6.0.0",
        "dayjs": "^1.11.0",
        "next": "^14.0.0",
        "react": "^18.0.0",
        "react-dom": "^18.0.0",
        "react-hook-form": "^7.43.0",
        "react-toastify": "^10.0.0"
    },
    "dependencies": {
        "@mui/lab": "5.0.0-alpha.127",
        "axios": "^1.17.0",
        "cookies-next": "^4.2.1",
        "jszip": "^3.10.1",
        "jwt-decode": "^3.1.2",
        "keycloak-js": "^25.0.1",
        "leaflet": "^1.9.4",
        "leaflet-defaulticon-compatibility": "^0.1.2",
        "lodash.clonedeep": "^4.5.0",
        "lodash.get": "^4.4.2",
        "lodash.hasin": "^4.5.2",
        "react-dropzone": "^14.3.8",
        "react-google-recaptcha": "^2.1.0",
        "react-imask": "^6.6.0",
        "react-leaflet": "^4.2.1",
        "react-query": "^3.39.3",
        "tinycolor2": "^1.6.0",
        "write-excel-file": "^4.0.7"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.21.4",
        "@babel/preset-react": "^7.18.6",
        "@babel/preset-typescript": "^7.21.4",
        "@emotion/react": "^11.10.6",
        "@emotion/styled": "^11.10.6",
        "@mui/icons-material": "^5.11.16",
        "@mui/material": "^5.12.1",
        "@mui/x-date-pickers": "^6.2.0",
        "@storybook/addon-docs": "9.0.17",
        "@storybook/addon-links": "9.0.17",
        "@storybook/nextjs": "^9.0.17",
        "@storybook/react-webpack5": "9.0.17",
        "@storybook/testing-library": "^0.2.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@tsconfig/recommended": "^1.0.2",
        "@types/keycloak-js": "^3.4.1",
        "@types/leaflet": "^1.9.16",
        "@types/lodash.clonedeep": "^4.5.9",
        "@types/lodash.get": "^4.4.7",
        "@types/lodash.hasin": "^4.5.7",
        "@types/node": "^20.0.0",
        "@types/react": "^18.0.37",
        "@types/react-dom": "^18.3.0",
        "@types/react-google-recaptcha": "^2.1.5",
        "@types/tinycolor2": "^1.4.6",
        "@vitest/coverage-v8": "^3.2.7",
        "dayjs": "^1.11.11",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^9.1.2",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-storybook": "^9.1.20",
        "globals": "^15.15.0",
        "jsdom": "^26.1.0",
        "microbundle": "^0.15.0",
        "msw": "^2.15.0",
        "next": "^14.2.35",
        "pixelmatch": "6.0.0",
        "playwright": "1.55.0",
        "pngjs": "7.0.0",
        "prettier": "^3.9.8",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-hook-form": "^7.43.9",
        "react-toastify": "^10.0.4",
        "storybook": "^9.0.17",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.70.1",
        "vitest": "^3.2.7"
    },
    "scripts": {
        "sync-version": "node sync-version.cjs",
        "prebuild": "npm run sync-version",
        "build": "microbundle --tsconfig tsconfig.microbundle.json --format \"cjs,es\"",
        "dev": "tsc --watch",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "api": "json-server --watch api-test.json --port 7171",
        "link": "npx tsc && cp lib-package.json dist/package.json && cd dist && npm link",
        "typecheck": "tsc --noEmit",
        "snapshots": "./scripts/snapshots-in-docker.sh",
        "snapshots:update": "./scripts/snapshots-in-docker.sh --update",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \".storybook/**/*.ts\" \"eslint.config.mjs\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \".storybook/**/*.ts\" \"eslint.config.mjs\"",
        "check:package": "./scripts/check-package.sh",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "engines": {
        "node": ">=20.19"
    }
}
