{
    "name": "@ssplib/react-components",
    "version": "1.0.0-rc.3",
    "description": "SSP React Components",
    "author": "Pedro Henrique <sr.hudrick@gmail.com>",
    "license": "MIT",
    "private": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist/**/*"
    ],
    "peerDependencies": {
        "@emotion/react": "^11.9.0",
        "@emotion/styled": "^11.8.1",
        "@mui/icons-material": "^9.0.0",
        "@mui/material": "^9.0.0",
        "@mui/x-date-pickers": "^9.0.0",
        "dayjs": "^1.11.0",
        "next": "^16.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-hook-form": "^7.43.0",
        "react-toastify": "^11.0.0"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "jszip": "^3.10.2",
        "jwt-decode": "^4.0.0",
        "keycloak-js": "^26.2.4",
        "leaflet": "^1.9.4",
        "leaflet-defaulticon-compatibility": "^0.1.2",
        "lodash.clonedeep": "^4.5.0",
        "lodash.get": "^4.4.2",
        "lodash.hasin": "^4.5.2",
        "react-dropzone": "^20.1.2",
        "react-imask": "^7.6.1",
        "react-leaflet": "^5.0.0",
        "tinycolor2": "^1.6.0",
        "write-excel-file": "^4.1.1"
    },
    "devDependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@eslint/js": "^10.0.1",
        "@mui/icons-material": "^9.4.0",
        "@mui/material": "^9.4.0",
        "@mui/x-date-pickers": "^9.14.0",
        "@storybook/addon-docs": "^10.6.1",
        "@storybook/addon-links": "^10.6.1",
        "@storybook/nextjs": "^10.6.1",
        "@storybook/react-webpack5": "^10.6.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@tsconfig/recommended": "^1.0.13",
        "@types/leaflet": "^1.9.22",
        "@types/lodash.clonedeep": "^4.5.9",
        "@types/lodash.get": "^4.4.9",
        "@types/lodash.hasin": "^4.5.9",
        "@types/node": "^24.19.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/tinycolor2": "^1.4.6",
        "@vitest/coverage-v8": "^5.0.2",
        "dayjs": "^1.11.23",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-storybook": "^10.6.1",
        "globals": "^17.12.0",
        "jsdom": "^30.1.1",
        "json-server": "^0.17.4",
        "next": "^16.3.7",
        "pixelmatch": "7.2.0",
        "playwright": "1.63.0",
        "pngjs": "7.0.0",
        "prettier": "^3.9.9",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-hook-form": "^7.89.0",
        "react-toastify": "^11.1.0",
        "storybook": "^10.6.1",
        "tsdown": "^0.23.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "unrun": "^0.3.1",
        "vitest": "^5.0.2"
    },
    "scripts": {
        "sync-version": "node sync-version.cjs",
        "prebuild": "npm run sync-version",
        "build": "tsdown",
        "dev": "tsc --watch",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "api": "json-server --watch api-test.json --port 7171",
        "typecheck": "tsc --noEmit",
        "snapshots": "./scripts/snapshots-in-docker.sh",
        "snapshots:update": "./scripts/snapshots-in-docker.sh --update",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \".storybook/**/*.ts\" \"eslint.config.mjs\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \".storybook/**/*.ts\" \"eslint.config.mjs\"",
        "check:package": "./scripts/check-package.sh",
        "smoke": "./scripts/smoke-app.sh",
        "pack:local": "./scripts/pack-local.sh",
        "test": "vitest run",
        "test:watch": "vitest",
        "interacoes": "node scripts/interacoes.mjs",
        "e2e:keycloak": "./scripts/e2e-keycloak.sh"
    },
    "engines": {
        "node": "^22.22.2 || >=24.15.0"
    }
}
