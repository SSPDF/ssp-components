    "scripts": {
        "sync-version": "node sync-version.cjs",
        "prebuild": "npm run sync-version",
        "build": "tsdown",
        "dev": "tsc --watch",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "api": "json-server --watch api-test.json --port 7171",
        "typecheck": "tsc --noEmit",
        "snapshots": "./scripts/snapshots-in-docker.sh",
        "snapshots:update": "./scripts/snapshots-in-docker.sh --update",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \".storybook/**/*.ts\" \"eslint.config.mjs\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \".storybook/**/*.ts\" \"eslint.config.mjs\"",
        "check:package": "./scripts/check-package.sh",
        "smoke": "./scripts/smoke-app.sh",
        "pack:local": "./scripts/pack-local.sh",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "engines": {
        "node": "^22.22.2 || >=24.15.0"
    }
