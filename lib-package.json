{
    "name": "@ssplib/react-components",
    "version": "1.0.0-rc.1",
    "description": "SSP React Components",
    "author": "Pedro Henrique <sr.hudrick@gmail.com>",
    "license": "MIT",
    "main": "./index.cjs",
    "module": "./index.js",
    "types": "./index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./index.d.ts",
                "default": "./index.js"
            },
            "require": {
                "types": "./index.d.cts",
                "default": "./index.cjs"
            }
        },
        "./types/auth": {
            "import": {
                "types": "./types/auth.d.ts",
                "default": "./types/auth.js"
            },
            "require": {
                "types": "./types/auth.d.cts",
                "default": "./types/auth.cjs"
            }
        },
        "./types/form": {
            "import": {
                "types": "./types/form.d.ts",
                "default": "./types/form.js"
            },
            "require": {
                "types": "./types/form.d.cts",
                "default": "./types/form.cjs"
            }
        }
    },
    "engines": {
        "node": ">=22"
    },
    "peerDependencies": {
        "@emotion/react": "^11.9.0",
        "@emotion/styled": "^11.8.1",
        "@mui/icons-material": "^7.3.0 || ^9.0.0",
        "@mui/material": "^7.3.0 || ^9.0.0",
        "@mui/x-date-pickers": "^8.0.0 || ^9.0.0",
        "dayjs": "^1.11.0",
        "next": "^14.0.0 || ^15.0.0 || ^16.0.0",
        "react": "^18.0.0",
        "react-dom": "^18.0.0",
        "react-hook-form": "^7.43.0",
        "react-toastify": "^10.0.0 || ^11.0.0"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "jszip": "^3.10.2",
        "jwt-decode": "^4.0.0",
        "keycloak-js": "^26.2.4",
        "leaflet": "^1.9.4",
        "leaflet-defaulticon-compatibility": "^0.1.2",
        "lodash.clonedeep": "^4.5.0",
        "lodash.get": "^4.4.2",
        "lodash.hasin": "^4.5.2",
        "react-dropzone": "^20.1.2",
        "react-imask": "^7.6.1",
        "react-leaflet": "^4.2.1",
        "tinycolor2": "^1.6.0",
        "write-excel-file": "^4.1.1"
    },
    "devDependencies": {
        "@types/lodash.clonedeep": "^4.5.9",
        "@types/lodash.get": "^4.4.9",
        "@types/lodash.hasin": "^4.5.9",
        "prop-types": "15.8.1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SSPDF/ssp-components.git"
    },
    "keywords": [
        "front",
        "react",
        "components",
        "ssp",
        "df"
    ],
    "bugs": {
        "url": "https://github.com/SSPDF/ssp-components/issues"
    },
    "homepage": "https://github.com/SSPDF/ssp-components#readme"
}
